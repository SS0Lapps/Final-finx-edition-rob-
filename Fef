--  Utils (تُعرّف قبل Window لضمان توفرها)
-- ═══════════════════════════════════════════════════════════
function Hub.log(type, msg)
    local entry = string.format("[%s] [%s] %s", os.date("%H:%M:%S"), type, msg)
    table.insert(Hub.Logs, 1, entry)
    if #Hub.Logs > 200 then table.remove(Hub.Logs) end
    print("[E1s] " .. entry)
end

function Hub.notify(text, dur)
    text = tostring(text)
    table.insert(Hub.Notifications, 1, {
        time = os.date("%H:%M:%S"),
        text = text,
    })
    if #Hub.Notifications > 200 then table.remove(Hub.Notifications) end
    
    local lower = text:lower()
    if lower:find("خطأ") or lower:find("❌") or lower:find("error") or lower:find("فشل") then
        Hub.log("ERR", text)
    end
    
    pcall(function()
        windUI:Notify({ Title = "🖥️ Console", Content = text, Duration = dur or 2 })
    end)
end

function Hub.copy(text, label)
    if setclipboard then
        setclipboard(text)
        Hub.notify("✅ " .. (label or "تم النسخ"), 2)
    else
        Hub.notify("❌ setclipboard غير متاح", 2)
    end
end

function Hub.jsonEncode(data)
    local ok, r = pcall(function() return HttpService:JSONEncode(data) end)
    return ok and r or tostring(data)
end

local notify = Hub.notify
local copy = Hub.copy

