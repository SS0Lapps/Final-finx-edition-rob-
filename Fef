    Title = "🎯 توليد سكربت",
    Callback = function()
        local path = GenPath.Value
        local name = GenName.Value
        if path == "" then notify("❌ املأ المسار", 2); return end
        if name == "" then name = path:match("[^%.]+$") or "Remote" end
        local script = buildRemoteScript(path, name, GenArgs.Value)
        copy(script, "سكربت " .. name)
    end,
})

