-- ═══════════════════════════════════════════════════════════
--  ID Generator
-- ═══════════════════════════════════════════════════════════
local function generateExtId(name)
    local guid = HttpService:GenerateGUID(false):gsub("-", ""):sub(1, 12)
    return "E1s-" .. guid .. "-" .. #name
end

-- ═══════════════════════════════════════════════════════════
--  Register
-- ═══════════════════════════════════════════════════════════
function Hub.Register(info)
    info = info or {}
    local name = info.name or ("Ext_" .. os.time())
    local extId = info.id or generateExtId(name)
    
    if Hub.ExtById[extId] then
        notify("⚠️ ID مكرر", 2)
        return false, "duplicate_id"
    end
    if Hub.ExtNameSet[name] then
        notify("⚠️ الاسم مكرر: " .. name, 2)
        return false, "duplicate_name"
    end
    
    Hub.ExtCount = Hub.ExtCount + 1
    info.id = extId
    info.index = Hub.ExtCount
    info.time = os.date("%H:%M:%S")
    
    table.insert(Hub.Extensions, info)
    Hub.ExtById[extId] = info
    Hub.ExtNameSet[name] = true
    Hub.log("REG", name .. " v" .. (info.version or "1.0"))
    
    if Hub.RefreshExtList then pcall(Hub.RefreshExtList) end
    notify("✅ " .. name .. " v" .. (info.version or "1.0"), 3)
    return true, extId
end

-- ═══════════════════════════════════════════════════════════
--  Run — Direct Environment (No Sandbox)
-- ═══════════════════════════════════════════════════════════
function Hub.Run(code, extName, extInfo)
    if not code or code == "" then
        notify("❌ الكود فارغ", 2)
        return false
    end
    
    extName = extName or ("Ext_" .. os.time())
    extInfo = extInfo or {}
    extInfo.name = extInfo.name or extName
    
    local extId = extInfo.id or generateExtId(extName)
    
    local fn, err = loadstring(code, "=E1sExt_" .. extId)
    if not fn then
        notify("❌ خطأ: " .. tostring(err):sub(1, 60), 3)
        Hub.log("ERR", "Load: " .. tostring(err):sub(1, 50))
        return false, err
    end
    
    -- استخدم getgenv مباشرة (بدون sandbox)
    local env = getgenv and getgenv() or _G
    if setfenv then
        pcall(function() setfenv(fn, env) end)
    end
    
    local ok, result = pcall(fn)
    
    if ok then
        -- دعم init()
        if type(result) == "table" and type(result.init) == "function" then
            local initOk, initErr = pcall(result.init)
            if not initOk then
                Hub.log("INITERR", tostring(initErr):sub(1, 80))
            end
        end
        
        -- سجل المصدر
        Hub.ExtSources[extId] = {
            name = extName,
            code = code,
            version = extInfo.version or "1.0",
        }
        
        local reg = Hub.Register({
            name = extName,
            version = extInfo.version or "1.0",
            description = extInfo.description or "",
        })
        return reg
    else
        notify("❌ فشل: " .. tostring(result):sub(1, 60), 3)
        Hub.log("ERR", "Run: " .. tostring(result):sub(1, 50))
        print("[E1s FULL ERROR] " .. tostring(result))
        return false, result
    end
end

function Hub.RunURL(url, extName)
    if not url or url == "" then
        notify("❌ الرابط فارغ", 2)
        return false
    end
    
    Hub.log("URL", "Fetching: " .. url:sub(1, 60))
    notify("🌐 جاري التحميل...", 2)
    
    local ok, code = pcall(function() return game:HttpGet(url, true) end)
    if not ok or not code or #code < 10 then
        notify("❌ فشل التحميل", 3)
        Hub.log("ERR", "URL fetch failed")
        return false
    end
    
    table.insert(Hub.URLs, 1, string.format("[%s] %s", os.date("%H:%M:%S"), url:sub(1, 80)))
    if #Hub.URLs > 50 then table.remove(Hub.URLs) end
    
    Hub.log("URL", "Loaded " .. #code .. " bytes")
    return Hub.Run(code, extName or ("URL_" .. os.date("%H%M%S")))
end

function Hub.Remove(extId)
    if not Hub.ExtById[extId] then return false end
    local e = Hub.ExtById[extId]
    Hub.ExtById[extId] = nil
    Hub.ExtNameSet[e.name] = nil
    Hub.ExtSources[extId] = nil
    for i, x in ipairs(Hub.Extensions) do
        if x.id == extId then table.remove(Hub.Extensions, i); break end
    end
    Hub.ExtCount = Hub.ExtCount - 1
    Hub.log("DEL", e.name)
    if Hub.RefreshExtList then Hub.RefreshExtList() end
    notify("🗑️ حُذف: " .. e.name, 2)
    return true
end

