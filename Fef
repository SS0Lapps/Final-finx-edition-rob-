local function buildRemoteScript(path, name, args)
    local L = {}
    local function w(s) table.insert(L, s) end
    
    w("-- ═══════════════════════════════════════════════")
    w("-- 🎯 " .. name .. " — Remote Script")
    w("-- Remote: " .. path)
    w("-- Generated: " .. os.date("%Y-%m-%d %H:%M:%S"))
    w("-- ═══════════════════════════════════════════════")
    w("")
    w('local Players = game:GetService("Players")')
    w("local LocalPlayer = Players.LocalPlayer")
    w("")
    w("local windUI = loadstring(game:HttpGet(")
    w('    "https://github.com/Footagesus/WindUI/releases/latest/download/main.lua"')
    w("))()")
    w("")
    w("local Window = windUI:CreateWindow({")
    w('    Title = "🎯 ' .. name .. '",')
    w('    Author = "E1s Remote Script",')
    w('    Folder = "E1sRemoteScripts",')
    w('    Icon = "crosshair",')
    w('    Theme = "Dark",')
    w("    Size = UDim2.fromOffset(500, 450),")
    w("})")
    w("")
    w('local MainTab = Window:Tab({ Title = "الرئيسية", Icon = "zap" })')
    w('local MainSec = MainTab:Section({ Title = "🚀 إطلاق" })')
    w("")
    w("MainSec:Paragraph({")
    w('    Title = "' .. name .. '",')
    w('    Desc = "Remote: ' .. path .. '",')
    w("})")
    w("")
    w("local ArgsInput = MainSec:Input({")
    w('    Title = "📝 Args (فاصلة)",')
    w('    Placeholder = "1, \'text\', true",')
    w(string.format("    Default = %q,", args or ""))
    w("})")
    w("")
    w("local function getRemote()")
    w("    local parts = {}")
    w(string.format("    for p in string.gmatch(%q, \"[^.]+\") do", path))
    w("        table.insert(parts, p)")
    w("    end")
    w("    local obj = game")
    w("    for _, p in ipairs(parts) do")
    w("        obj = obj:FindFirstChild(p)")
    w("        if not obj then return nil end")
    w("    end")
    w("    return obj")
    w("end")
    w("")
    w("local function parseArgs(str)")
    w("    local a = {}")
    w("    if not str or str == \"\" then return a end")
    w("    for arg in string.gmatch(str, \"([^,]+)\") do")
    w("        arg = arg:match(\"^%s*(.-)%s*$\")")
    w("        local n = tonumber(arg)")
    w("        if n then table.insert(a, n)")
    w("        elseif arg == \"true\" then table.insert(a, true)")
    w("        elseif arg == \"false\" then table.insert(a, false)")
    w("        else table.insert(a, arg)")
    w("        end")
    w("    end")
    w("    return a")
    w("end")
    w("")
    w("local function fireRemote()")
    w("    local remote = getRemote()")
    w("    if not remote then")
    w('        windUI:Notify({ Title = "❌", Content = "الريموت غير موجود", Duration = 2 })')
    w("        return")
    w("    end")
    w("    local a = parseArgs(ArgsInput.Value)")
    w("    local ok, err = pcall(function()")
    w('        if remote:IsA("RemoteEvent") then')
    w("            remote:FireServer(unpack(a))")
    w("        else")
    w("            remote:InvokeServer(unpack(a))")
    w("        end")
    w("    end)")
    w("    if ok then")
    w(string.format("        windUI:Notify({ Title = \"✅ %s\", Content = \"تم\", Duration = 2 })", name))
    w("    else")
    w('        windUI:Notify({ Title = "❌ فشل", Content = tostring(err):sub(1, 50), Duration = 3 })')
    w("    end")
    w("end")
    w("")
    w("MainSec:Button({")
    w(string.format("    Title = \"🚀 إطلاق %s\",", name))
    w("    Callback = fireRemote,")
    w("})")
    w("")
    w("MainSec:Button({")
    w('    Title = "🚀 إطلاق ×5",')
    w("    Callback = function()")
    w("        for i = 1, 5 do fireRemote(); task.wait(0.1) end")
    w("    end,")
    w("})")
    w("")
    w("MainSec:Button({")
    w('    Title = "🚀 إطلاق ×20 (Spam)",')
    w("    Callback = function()")
    w("        task.spawn(function()")
    w("            for i = 1, 20 do fireRemote(); task.wait(0.08) end")
    w("        end)")
    w("    end,")
    w("})")
    w("")
    w("local loopOn = false")
    w("MainSec:Toggle({")
    w('    Title = "🔁 تلقائي",')
    w("    Default = false,")
    w("    Callback = function(v)")
    w("        loopOn = v")
    w("        if v then")
    w("            task.spawn(function()")
    w("                while loopOn do fireRemote(); task.wait(0.5) end")
    w("            end)")
    w("        end")
    w("    end,")
    w("})")
    w("")
    w('local InfoTab = Window:Tab({ Title = "معلومات", Icon = "info" })')
    w('local InfoSec = InfoTab:Section({ Title = "📋 التفاصيل" })')
    w("")
    w("InfoSec:Paragraph({")
    w('    Title = "📡 المسار",')
    w(string.format("    Desc = %q,", path))
    w("})")
    w("")
    w("InfoSec:Button({")
    w('    Title = "📋 نسخ المسار",')
    w("    Callback = function()")
    w(string.format("        setclipboard(%q)", path))
    w("        windUI:Notify({ Title = \"✅\", Content = \"تم النسخ\", Duration = 2 })")
    w("    end,")
    w("})")
    w("")
    w("windUI:Notify({")
    w(string.format("    Title = \"🎯 %s\",", name))
    w('    Content = "السكربت جاهز",')
    w("    Duration = 3,")
    w("})")
    
    return table.concat(L, "\n")
end

