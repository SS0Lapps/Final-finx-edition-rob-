local scanning = false

local function fullScan()
    if scanning then
        Hub.notify("⚠️ الفحص شغال بالفعل", 2)
        return
    end
    scanning = true
    Hub.notify("🔍 بدء الفحص الشامل...", 3)
    
    -- Reset
    for k, v in pairs(Hub.Intel) do
        if type(v) == "table" then
            Hub.Intel[k] = {}
        end
    end
    
    task.spawn(function()
        local queue = {
            {ReplicatedStorage, 0, "ReplicatedStorage"},
            {workspace, 0, "workspace"},
            {PlayerGui, 0, "PlayerGui"},
            {game:GetService("StarterGui"), 0, "StarterGui"},
            {game:GetService("StarterPack"), 0, "StarterPack"},
            {game:GetService("Lighting"), 0, "Lighting"},
            {game:GetService("SoundService"), 0, "SoundService"},
            {game:GetService("Chat"), 0, "Chat"},
        }
        
        local processed = 0
        local total = 0
        
        while #queue > 0 do
            local item = table.remove(queue, 1)
            local container, depth, path = item[1], item[2], item[3]
            
            if depth <= 6 then
                local ok, children = pcall(function() return container:GetChildren() end)
                if ok then
                    for _, obj in ipairs(children) do
                        processed = processed + 1
                        total = total + 1
                        
                        -- إراحة كل 25 كائن
                        if processed % 25 == 0 then task.wait() end
                        
                        local ok2, cls = pcall(function() return obj.ClassName end)
                        if not ok2 then continue end
                        
                        local objPath = path .. "." .. obj.Name
                        
                        -- ═══ تصنيف الكائن ═══
                        
                        -- 1) صور
                        if cls == "ImageLabel" or cls == "ImageButton" then
                            pcall(function()
                                if obj.Image and obj.Image ~= "" then
                                    local id = obj.Image:match("(%d+)")
                                    table.insert(Hub.Intel.Images, {
                                        name = obj.Name, id = obj.Image, assetId = id, path = objPath
                                    })
                                end
                            end)
                        elseif cls == "Decal" or cls == "Texture" then
                            pcall(function()
                                if obj.Texture and obj.Texture ~= "" then
                                    local id = obj.Texture:match("(%d+)")
                                    table.insert(Hub.Intel.Images, {
                                        name = obj.Name, id = obj.Texture, assetId = id, path = objPath
                                    })
                                end
                            end)
                        elseif cls == "Sky" then
                            pcall(function()
                                for _, key in ipairs({"SkyboxBk", "SkyboxDn", "SkyboxFt", "SkyboxLf", "SkyboxRt", "SkyboxUp"}) do
                                    if obj[key] and obj[key] ~= "" then
                                        table.insert(Hub.Intel.Images, {
                                            name = obj.Name .. "_" .. key,
                                            id = obj[key],
                                            assetId = obj[key]:match("(%d+)"),
                                            path = objPath .. "." .. key
                                        })
                                    end
                                end
                            end)
                        end
                        
                        -- 2) فيديو
                        if cls == "VideoFrame" or cls == "VideoPlayer" then
                            pcall(function()
                                if obj.Video and obj.Video ~= "" then
                                    table.insert(Hub.Intel.Videos, {
                                        name = obj.Name, id = obj.Video,
                                        assetId = obj.Video:match("(%d+)"), path = objPath
                                    })
                                end
                            end)
                        end
                        
                        -- 3) أصوات
                        if cls == "Sound" then
                            pcall(function()
                                if obj.SoundId and obj.SoundId ~= "" then
                                    table.insert(Hub.Intel.Sounds, {
                                        name = obj.Name, id = obj.SoundId,
                                        assetId = obj.SoundId:match("(%d+)"),
                                        volume = obj.Volume, pitch = obj.PlaybackSpeed,
                                        looped = obj.Looped, path = objPath
                                    })
                                end
                            end)
                        end
                        
                        -- 4) أنيميشن
                        if cls == "Animation" then
                            pcall(function()
                                if obj.AnimationId and obj.AnimationId ~= "" then
                                    table.insert(Hub.Intel.Animations, {
                                        name = obj.Name, id = obj.AnimationId,
                                        assetId = obj.AnimationId:match("(%d+)"), path = objPath
                                    })
                                end
                            end)
                        end
                        
                        -- 5) Meshes
                        if cls == "SpecialMesh" or cls == "MeshPart" or cls == "CylinderMesh" then
                            pcall(function()
                                if obj.MeshId and obj.MeshId ~= "" then
                                    table.insert(Hub.Intel.Meshes, {
                                        name = obj.Name, id = obj.MeshId,
                                        assetId = obj.MeshId:match("(%d+)"), path = objPath
                                    })
                                end
                            end)
                        end
                        
                        -- 6) ريموتات
                        if cls == "RemoteEvent" or cls == "RemoteFunction" then
                            table.insert(Hub.Intel.Remotes, {
                                name = obj.Name, class = cls, path = objPath
                            })
                        end
                        
                        -- 7) سكربتات
                        if cls == "LocalScript" or cls == "Script" or cls == "ModuleScript" then
                            table.insert(Hub.Intel.Scripts, {
                                name = obj.Name, class = cls, path = objPath,
                                hasSource = pcall(function() return obj.Source and #obj.Source > 0 end)
                            })
                        end
                        
                        -- 8) فولدرات
                        if cls == "Folder" then
                            table.insert(Hub.Intel.Folders, {
                                name = obj.Name, path = objPath
                            })
                        end
                        
                        -- 9) مسارات كل الكائنات
                        table.insert(Hub.Intel.Paths, objPath)
                        
                        -- 10) أسماء ملفات (Scripts, Modules, Folders, Models)
                        if cls == "Script" or cls == "LocalScript" or cls == "ModuleScript" 
                        or cls == "Folder" or cls == "Model" then
                            table.insert(Hub.Intel.Files, {
                                name = obj.Name, class = cls, path = objPath
                            })
                        end
                        
                        -- ═══ التعمق ═══
                        if cls == "Folder" or cls == "Model" or cls == "Configuration" 
                        or cls == "Actor" or cls == "Workspace" or cls == "PlayerGui"
                        or cls == "ScreenGui" or cls == "Frame" or cls == "GuiMain" then
                            table.insert(queue, {obj, depth + 1, objPath})
                        end
                    end
                end
            end
        end
        
        scanning = false
        Hub.notify(string.format("✅ انتهى! %d عنصر تم فحصه", total), 5)
        print("[E1s Intel] Total: " .. total)
        print("[E1s Intel] Images: " .. #Hub.Intel.Images)
        print("[E1s Intel] Videos: " .. #Hub.Intel.Videos)
        print("[E1s Intel] Sounds: " .. #Hub.Intel.Sounds)
        print("[E1s Intel] Animations: " .. #Hub.Intel.Animations)
        print("[E1s Intel] Meshes: " .. #Hub.Intel.Meshes)
        print("[E1s Intel] Remotes: " .. #Hub.Intel.Remotes)
        print("[E1s Intel] Scripts: " .. #Hub.Intel.Scripts)
        print("[E1s Intel] Folders: " .. #Hub.Intel.Folders)
        print("[E1s Intel] Paths: " .. #Hub.Intel.Paths)
    end)
end

-- ═══════════════════════════════════════════════════════════
--  📡 فحص السورس + الأنماط (Pattern Extractor)
-- ═══════════════════════════════════════════════════════════
local function extractPatterns()
    Hub.notify("🔍 استخراج الأنماط من السورس...", 2)
    Hub.Intel.URLs = {}
    Hub.Intel.Keys = {}
    Hub.Intel.Cookies = {}
    Hub.Intel.Protected = {}
    
    task.spawn(function()
        local processed = 0
        for _, s in ipairs(Hub.Intel.Scripts) do
            processed = processed + 1
            if processed % 10 == 0 then task.wait() end
            
            -- نحتاج الكائن نفسه
            local parts = {}
            for p in string.gmatch(s.path, "[^.]+") do table.insert(parts, p) end
            
            local obj = game
            for _, p in ipairs(parts) do
                obj = obj:FindFirstChild(p)
                if not obj then break end
            end
            
            if obj then
                pcall(function()
                    local src = obj.Source
                    if not src or #src == 0 then return end
                    
                    -- URLs
                    for url in src:gmatch("https?://[%w%.%-_/:%?&=#@!%+]+") do
                        if #url < 200 and not table.find(Hub.Intel.URLs, url) then
                            table.insert(Hub.Intel.URLs, url)
                        end
                    end
                    
                    -- Discord Webhooks
                    for wh in src:gmatch("https://discord%.com/api/webhooks/[%d]+/[%w%-_]+") do
                        if not table.find(Hub.Intel.URLs, wh) then
                            table.insert(Hub.Intel.URLs, wh)
                        end
                    end
                    
                    -- Keys / Tokens
                    for k in src:gmatch("[Kk]ey%s*[=:]%s*[\"']([%w%-_]+)[\"']") do
                        if #k > 5 and #k < 100 and not table.find(Hub.Intel.Keys, k) then
                            table.insert(Hub.Intel.Keys, k)
                        end
                    end
                    for t in src:gmatch("[Tt]oken%s*[=:]%s*[\"']([%w%.%-_]+)[\"']") do
                        if #t > 5 and #t < 200 and not table.find(Hub.Intel.Keys, t) then
                            table.insert(Hub.Intel.Keys, t)
                        end
                    end
                    
                    -- Cookies
                    for c in src:gmatch("_|WARNING:-DO%-NOT%-SHARE%-THIS%-|_[%w%.%-_]+") do
                        if not table.find(Hub.Intel.Cookies, c) then
                            table.insert(Hub.Intel.Cookies, c)
                        end
                    end
                    
                    -- Protected info (أي شيء يبدو محمي)
                    if src:find("HttpService:GetAsync") or src:find("HttpService:PostAsync") then
                        table.insert(Hub.Intel.Protected, {
                            name = s.name, path = s.path, type = "HTTP", 
                            note = "يستخدم HTTP Requests"
                        })
                    end
                    if src:find("loadstring") then
                        table.insert(Hub.Intel.Protected, {
                            name = s.name, path = s.path, type = "loadstring",
                            note = "يحمّل كود خارجي"
                        })
                    end
                end)
            end
        end
        Hub.notify(string.format("✅ %d URL | %d Key | %d Cookie", 
            #Hub.Intel.URLs, #Hub.Intel.Keys, #Hub.Intel.Cookies), 4)
    end)
end

-- ═══════════════════════════════════════════════════════════
--  🔬 فحص الحماية
-- ═══════════════════════════════════════════════════════════
local function analyzeAntiCheat()
    Hub.notify("🛡️ تحليل الحماية...", 2)
    Hub.Intel.AntiCheat = {}
    
    local keywords = {
        "anticheat", "antiexploit", "guard", "shield", "detect", "ban",
        "kick", "hyperion", "byfron", "sentry", "sniffer", "protection",
        "tamper", "integrity", "verif", "ac_", "check", "monitor",
        "report", "punish", "violation", "honeypot", "trap",
    }
    
    task.spawn(function()
        local containers = {ReplicatedStorage, workspace, PlayerGui}
        local processed = 0
        for _, container in ipairs(containers) do
            local queue = {{container, 0}}
            while #queue > 0 do
                local item = table.remove(queue, 1)
                local c, d = item[1], item[2]
                if d <= 4 then
                    local ok, ch = pcall(function() return c:GetChildren() end)
                    if ok then
                        for _, o in ipairs(ch) do
                            processed = processed + 1
                            if processed % 30 == 0 then task.wait() end
                            local ln = o.Name:lower()
                            for _, kw in ipairs(keywords) do
                                if ln:find(kw) then
                                    table.insert(Hub.Intel.AntiCheat, {
                                        name = o.Name, class = o.ClassName,
                                        path = o:GetFullName(),
                                    })
                                    break
                                end
                            end
                            if o:IsA("Folder") or o:IsA("Model") then
                                table.insert(queue, {o, d + 1})
                            end
                        end
                    end
                end
            end
        end
        Hub.notify("⚠️ " .. #Hub.Intel.AntiCheat .. " عنصر حماية", 3)
    end)
end

-- ═══════════════════════════════════════════════════════════
--  🍪 Cookie Extractor
-- ═══════════════════════════════════════════════════════════
local function extractCookies()
    Hub.Intel.Cookies = {}
    Hub.notify("🍪 محاولة استخراج الكوكيز...", 2)
    
    local methods = {
        {name = "getcookie", fn = function() 
            if getcookie then return getcookie() end 
        end},
        {name = "syn.getCookie", fn = function() 
            if syn and syn.getCookie then return syn.getCookie() end 
        end},
        {name = "krnl.getcookie", fn = function() 
            if krnl and krnl.getcookie then return krnl.getcookie() end 
        end},
        {name = "Krnl (alt)", fn = function() 
            if Krnl and Krnl.getcookie then return Krnl.getcookie() end 
        end},
        {name = "httpget (httpbin)", fn = function()
            if httpget then
                local ok, r = pcall(function()
                    return httpget({Url = "https://httpbin.org/cookies"})
                end)
                if ok and r then return r.Body end
            end
        end},
        {name = "request (httpbin)", fn = function()
            local req = request or (syn and syn.request) or http_request
            if req then
                local ok, r = pcall(function()
                    return req({Url = "https://httpbin.org/cookies", Method = "GET"})
                end)
                if ok and r then return r.Body end
            end
        end},
    }
    
    local found = 0
    for _, m in ipairs(methods) do
        local ok, result = pcall(m.fn)
        if ok and result and tostring(result) ~= "" and #tostring(result) > 5 then
            table.insert(Hub.Intel.Cookies, {
                method = m.name,
                value = tostring(result):sub(1, 500)
            })
            found = found + 1
        end
    end
    Hub.notify(string.format("🍪 %d طريقة نجحت", found), 3)
end

