local KeySec = SecTab:Section({ Title = "🔑 Keys/Tokens" })

KeySec:Button({
    Title = "📋 نسخ كل Keys",
    Callback = function()
        if #Hub.Intel.Keys == 0 then Hub.notify("❌ لا يوجد", 2); return end
        Hub.copy(table.concat(Hub.Intel.Keys, "\n"), #Hub.Intel.Keys .. " Key")
    end,
})

local CkSec = SecTab:Section({ Title = "🍪 Cookies" })

CkSec:Button({
    Title = "📋 نسخ الكوكيز",
    Callback = function()
        if #Hub.Intel.Cookies == 0 then Hub.notify("❌ لا يوجد", 2); return end
        local lines = {}
        for _, c in ipairs(Hub.Intel.Cookies) do
            if type(c) == "table" then
                table.insert(lines, "-- [" .. (c.method or "?") .. "]")
                table.insert(lines, c.value)
            else
                table.insert(lines, tostring(c))
            end
        end
        Hub.copy(table.concat(lines, "\n"), #Hub.Intel.Cookies .. " كوكي")
    end,
})

local AcSec = SecTab:Section({ Title = "🛡️ الحماية" })

